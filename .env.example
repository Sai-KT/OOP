# ==============================================================================
# EduBridge Student Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure these variables in Render / Cloud Provider

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port for the built-in Java HttpServer (Render automatically sets this)
PORT=8080

# Relative or absolute path to the directory containing static frontend files
FRONTEND_DIR=frontend

# Cookie Security: Set to "true" in production HTTPS environments.
# Note: On Render, the server automatically inspects 'X-Forwarded-Proto: https'
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL / JDBC)
# ------------------------------------------------------------------------------
# --- Option A: Local Development MySQL ---
DB_URL=jdbc:mysql://localhost:3306/student_course_db
DB_USER=root
DB_PASSWORD=

# --- Option B: Aiven Free Cloud MySQL ---
# In the Aiven Console, find your MySQL Service URI. Format:
# DB_URL=jdbc:mysql://mysql-<project-id>.aivencloud.com:<port>/defaultdb?sslMode=REQUIRED
# DB_USER=avnadmin
# DB_PASSWORD=<your-aiven-password>

# ------------------------------------------------------------------------------
# 3. Initial Administrator Provisioning (Bootstrap)
# ------------------------------------------------------------------------------
# On startup, if no account with role 'ADMIN' exists in the database,
# EduBridge creates an initial administrator account using these credentials.
# If an admin already exists, these variables are safely ignored.
EDUBRIDGE_ADMIN_NAME=EduBridge Administrator
EDUBRIDGE_ADMIN_USERNAME=Admin
EDUBRIDGE_ADMIN_EMAIL=admin@edubridge.edu
EDUBRIDGE_ADMIN_PASSWORD=Pass@1234
